{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-cond-assign": ["error", "except-parens"]
  },
  "globals": {
    "chrome": "readonly",
    "window": "writable",
    "document": "readonly",
    "JDSUtils": "writable",
    "JDSApi": "writable",
    "JDSUI": "writable",
    "JDSDom": "writable",
    "JDSContent": "writable"
  }
}
