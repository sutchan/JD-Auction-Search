{
  "manifest_version": 3,
  "name": "京东夺宝岛搜索增强",
  "version": "1.6.9",
  "description": "京东夺宝岛（拍拍）列表页商品搜索增强：关键词实时过滤、跨页聚合、分类筛选，接口失效自动兜底。让夺宝岛商品一搜即得。",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "京东夺宝岛搜索增强"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://1paipai.jd.com/*",
    "*://*.jd.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://1paipai.jd.com/*"
      ],
      "js": [
        "src/utils/index.js",
        "src/utils/i18n.js",
        "src/utils/extract.js",
        "src/utils/price.js",
        "src/utils/format.js",
        "src/utils/transform.js",
        "src/utils/ui-shared.js",
        "src/api/index.js",
        "src/api/template.js",
        "src/api/interceptor.js",
        "src/api/paginator-rules.js",
        "src/api/paginator.js",
        "src/api/paginator-deep.js",
        "src/ui/index.js",
        "src/ui/tokens.js",
        "src/ui/components.js",
        "src/ui/styles.js",
        "src/ui/toolbar/history.js",
        "src/ui/toolbar/history-item.js",
        "src/ui/toolbar/events.js",
        "src/ui/toolbar.js",
        "src/ui/results/styles.js",
        "src/ui/results/host.js",
        "src/ui/results.js",
        "src/ui/countdown.js",
        "src/ui/price-render.js",
        "src/ui/products.js",
        "src/ui/skeleton.js",
        "src/dom/index.js",
        "src/dom/selectors.js",
        "src/dom/observer.js",
        "src/dom/extract.js",
        "src/dom/price-text.js",
        "src/dom/native-list.js",
        "src/dom/filter.js",
        "src/content/enhancer.js",
        "src/content/search.js",
        "src/content/deep-search.js",
        "src/content.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles.css"
      ],
      "matches": [
        "*://1paipai.jd.com/*"
      ]
    }
  ]
}
